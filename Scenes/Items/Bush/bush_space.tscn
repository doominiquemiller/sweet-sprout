[sub_resource type="GDScript" id="GDScript_3ro8n"]
script/source = "extends Area2D

# =============================================================
#  BushSpace — Parcela de Arbustos (Sincronizada con los Grupos del Mundo)
# =============================================================

@export var fruit_bush_scene : PackedScene = preload(\"res://Scenes/Items/Bush/fruit_bush.tscn\")

var is_player_inside : bool = false
var hosted_plant     : Node = null

const SEED_CONFIG : Dictionary = {
	\"blackberry_seeds\": {\"type\": \"blackberry\"},
	\"blueberry_seeds\":  {\"type\": \"blueberry\"},
	\"raspberry_seeds\":  {\"type\": \"raspberry\"}
}

func _ready() -> void:
	# CORREGIDO: Añadido a ambos grupos (singular y plural) para evitar fallos con world.gd u otros sistemas
	add_to_group(\"crop_space\")
	add_to_group(\"crop_spaces\")
	
	monitoring = true
	monitorable = true
	
	if body_entered.is_connected(_on_body_entered):
		body_entered.disconnect(_on_body_entered)
	if body_exited.is_connected(_on_body_exited):
		body_exited.disconnect(_on_body_exited)
		
	body_entered.connect(_on_body_entered)
	body_exited.connect(_on_body_exited)

func _unhandled_input(event: InputEvent) -> void:
	# Captura la tecla F física de forma limpia
	if event is InputEventKey and event.pressed and event.keycode == KEY_F:
		
		# Verificación manual si el motor físico se retrasó un frame
		if not is_player_inside:
			for body in get_overlapping_bodies():
				if body.is_in_group(\"player\") or body.name == \"Player\":
					is_player_inside = true
					break
		
		if is_player_inside:
			get_viewport().set_input_as_handled() # Consumimos el input para que nadie más lo use
			_handle_interaction()

func _handle_interaction() -> void:
	# 1. SI YA HAY UN ARBUSTO INSTANCIADO
	if hosted_plant != null and is_instance_valid(hosted_plant):
		var ready_to_harvest = hosted_plant.is_ready if \"is_ready\" in hosted_plant else false
		
		if ready_to_harvest:
			if hosted_plant.has_method(\"collect_harvest\"):
				hosted_plant.collect_harvest() 
			else:
				print(\"⚠️ [BushSpace] Error: El script del arbusto no tiene el método collect_harvest.\")
		else:
			print(\"[BushSpace] Las bayas aún no están listas para ser cosechadas (Espera a que pasen los 2 minutos).\")
		
		return

	# 2. SI NO HAY NADA ALOJADO
	_try_plant()

func _try_plant() -> void:
	# CORREGIDO: Si tu sistema de selección sigue en la UI (Inventory), asegúrate de que el Autoload se llame así.
	# Si moviste la selección a Global, cámbialo a Global.get_item_seleccionado()
	var selected_seed : String = Inventory.get_item_seleccionado() if has_node(\"/root/Inventory\") else \"\"
	
	if selected_seed == \"\" or not SEED_CONFIG.has(selected_seed):
		print(\"[BushSpace] Selecciona una semilla de arbusto válida en tu inventario.\")
		return

	# CORREGIDO: Ahora usa correctamente el Autoload Global
	if not Global.has_item(selected_seed, 1):
		print(\"[BushSpace] No tienes más unidades de esta semilla.\")
		if has_node(\"/root/Inventory\") and Inventory.has_method(\"limpiar_seleccion\"):
			Inventory.limpiar_seleccion()
		return

	_plant_resource(selected_seed)

func _plant_resource(seed_id: String) -> void:
	var config = SEED_CONFIG[seed_id]
	var plant_type : String = config[\"type\"]
	
	if not fruit_bush_scene:
		print(\"⚠️ [BushSpace] ERROR: No se ha asignado la escena del arbusto en el Inspector.\")
		return

	Global.remove_item(seed_id, 1)

	var new_bush = fruit_bush_scene.instantiate()
	add_child(new_bush)
	
	new_bush.position = Vector2.ZERO
	new_bush.z_index = 1

	if new_bush.has_method(\"plant\"):
		new_bush.plant(plant_type)

	hosted_plant = new_bush
	
	new_bush.tree_exiting.connect(func():
		hosted_plant = null
		print(\"[BushSpace] Arbusto removido. Parcela libre de nuevo.\")
	)

	# CORREGIDO: Evita llamar a una función inexistente en Global. 
	# Si la limpieza de selección pertenece a la UI, interactúa con el Autoload Inventory.
	if not Global.has_item(seed_id, 1):
		if has_node(\"/root/Inventory\") and Inventory.has_method(\"limpiar_seleccion\"):
			Inventory.limpiar_seleccion()
		
	print(\"[BushSpace] ¡Arbusto de %s plantado con éxito!\" % plant_type)

# =============================================================
#  DETECCIÓN DEL JUGADOR
# =============================================================
func _on_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player\") or body.name == \"Player\":
		is_player_inside = true

func _on_body_exited(body: Node2D) -> void:
	if body.is_in_group(\"player\") or body.name == \"Player\":
		is_player_inside = false
"

